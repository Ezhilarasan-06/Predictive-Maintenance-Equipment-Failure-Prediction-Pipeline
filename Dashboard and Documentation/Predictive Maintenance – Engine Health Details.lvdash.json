{
  "datasets": [
    {
      "name": "29b18707",
      "displayName": "Engine Selector + Risk Table",
      "queryLines": [
        "SELECT\r\n",
        "  engine_id,\r\n",
        "  cycle,\r\n",
        "  failure_probability,\r\n",
        "  risk_level\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "WHERE engine_id = engine_id\r\n",
        "ORDER BY cycle\r\n"
      ]
    },
    {
      "name": "f28a77bb",
      "displayName": "Failure Probability Trend",
      "queryLines": [
        "SELECT\r\n",
        "  cycle,\r\n",
        "  engine_id,\r\n",
        "  failure_probability\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "WHERE engine_id = engine_id\r\n",
        "ORDER BY cycle\r\n"
      ]
    },
    {
      "name": "38d217ca",
      "displayName": "Risk Level Timeline",
      "queryLines": [
        "SELECT\r\n",
        "  cycle,\r\n",
        "  risk_level\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "WHERE engine_id = engine_id\r\n",
        "ORDER BY cycle\r\n"
      ]
    },
    {
      "name": "20f98b22",
      "displayName": "TOTAL ENGINES MONITORED",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "  COUNT(DISTINCT engine_id) AS total_engines\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n"
      ]
    },
    {
      "name": "19001484",
      "displayName": "HIGH RISK ENGINES (CRITICAL)",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "  COUNT(DISTINCT engine_id) AS high_risk_engines\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "WHERE risk_level = 'HIGH';\r\n"
      ]
    },
    {
      "name": "1fe2906a",
      "displayName": "Engine Risk Distribution",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "  risk_level,\r\n",
        "  COUNT(DISTINCT engine_id) AS engine_count\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "GROUP BY risk_level;\r\n"
      ]
    },
    {
      "name": "e584a161",
      "displayName": "TOP 10 MOST RISKY ENGINES",
      "queryLines": [
        "SELECT \r\n",
        "  engine_id,\r\n",
        "  MAX(failure_probability) AS max_failure_probability,\r\n",
        "  risk_level\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "GROUP BY engine_id, risk_level\r\n",
        "ORDER BY max_failure_probability DESC\r\n",
        "LIMIT 10;\r\n"
      ]
    },
    {
      "name": "1555ab7e",
      "displayName": "Prediction Distribution",
      "queryLines": [
        "SELECT\r\n",
        "  prediction,\r\n",
        "  COUNT(*) AS prediction_count\r\n",
        "FROM  predictive_cataglog.gold_layer.risk_score_table\r\n",
        "GROUP BY prediction\r\n",
        "ORDER BY prediction;\r\n"
      ]
    },
    {
      "name": "1209ba2d",
      "displayName": "Failure Probability Distribution",
      "queryLines": [
        "SELECT\r\n",
        "  failure_probability\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n"
      ]
    },
    {
      "name": "c110be8f",
      "displayName": "Risk Trend Over Cycles",
      "queryLines": [
        "SELECT\r\n",
        "  cycle,\r\n",
        "  AVG(failure_probability) AS avg_failure_probability\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "GROUP BY cycle\r\n",
        "ORDER BY cycle;\r\n"
      ]
    },
    {
      "name": "67ca9613",
      "displayName": "Risk Level Trend",
      "queryLines": [
        "SELECT\r\n",
        "  cycle,\r\n",
        "  risk_level,\r\n",
        "  COUNT(*) AS engine_count\r\n",
        "FROM predictive_cataglog.gold_layer.risk_score_table\r\n",
        "GROUP BY cycle, risk_level\r\n",
        "ORDER BY cycle;\r\n"
      ]
    },
    {
      "name": "2f700e78",
      "displayName": "Prediction vs Actual",
      "queryLines": [
        "SELECT\r\n",
        "  failure_label AS actual_label,\r\n",
        "  prediction AS predicted_label,\r\n",
        "  COUNT(*) AS count\r\n",
        "FROM predictive_cataglog.gold_layer.feature_table\r\n",
        "GROUP BY failure_label, prediction\r\n",
        "ORDER BY failure_label, prediction;\r\n",
        "\r\n",
        "\r\n",
        "\r\n"
      ]
    }
  ],
